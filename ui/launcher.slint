export struct TextSpan {
    text: string,
    is_match: bool,
}

export struct AppItem {
    id: string,
    name: string,
    spans: [TextSpan],
    exec: string,
    icon: image,
    subtitle: string,
}

export component LauncherWindow inherits Window {
    width: 500px;
    height: 580px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: root.theme_font;

    // --- Theme, injected from the config file (defaults: Dracula) ---
    in-out property <color> theme_bg: #282a36dd;
    in-out property <color> theme_text: #f8f8f2ff;
    in-out property <color> theme_prompt: #586e75ff;
    in-out property <color> theme_match: #8be9fdff;
    in-out property <color> theme_selection_match: #8be9fdff;
    in-out property <color> theme_selection_bg: #44475add;
    in-out property <color> theme_selection_text: #f8f8f2ff;
    in-out property <color> theme_border: #bd93f9ff;
    in-out property <string> theme_font: "JetBrains Mono";
    /// One full marquee cycle; longer means a slower, calmer scroll.
    in-out property <duration> theme_marquee_duration: 8s;

    in-out property <[AppItem]> items: [];
    in-out property <int> selected_index: 0;
    in-out property <string> query: "";

    callback search_changed(string);
    callback item_executed(int);
    callback escape_pressed();
    /// Ask the Rust side what a key event means; returns the action name
    /// ("up", "down", "close", "execute", "stools") or "" when unbound.
    callback resolve_key(text: string, ctrl: bool, alt: bool, shift: bool, meta: bool) -> string;

    private property <length> item_height: 34px;
    private property <length> item_spacing: 2px;
    private property <length> row_total_height: item_height + item_spacing;
    private property <length> list_view_height: 500px;

    public function select_next() {
        if (root.items.length > 0) {
            root.selected_index = Math.min(root.selected_index + 1, root.items.length - 1);
            root.ensure_visible(root.selected_index);
        }
    }

    public function select_prev() {
        if (root.items.length > 0) {
            root.selected_index = Math.max(root.selected_index - 1, 0);
            root.ensure_visible(root.selected_index);
        }
    }

    function ensure_visible(idx: int) {
        let item_top = idx * root.row_total_height;
        let item_bottom = item_top + root.item_height;

        if (item_top < -flick.viewport-y) {
            flick.viewport-y = -item_top;
        }
        if (item_bottom > -flick.viewport-y + root.list_view_height) {
            flick.viewport-y = -(item_bottom - root.list_view_height);
        }
    }

    public function prepare_show() {
        input.select-all();
        input.focus();
        flick.viewport-y = 0px;
    }

    /// Called when a new result set arrives (from the background search), which
    /// resets the selection — the list has to scroll back to the top with it.
    public function scroll_to_top() {
        flick.viewport-y = 0px;
    }

    forward-focus: input;

    main_container := Rectangle {
        width: 100%;
        height: 100%;
        background: root.theme_bg;
        border-radius: 12px;
        border-width: 1.5px;
        border-color: root.theme_border;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 6px;

            HorizontalLayout {
                height: 32px;
                spacing: 10px;

                Text {
                    text: ">";
                    color: root.theme_prompt;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                input := TextInput {
                    horizontal-stretch: 1;
                    font-size: 15px;
                    color: root.theme_text;
                    selection-background-color: root.theme_border;
                    selection-foreground-color: root.theme_bg;
                    single-line: true;
                    vertical-alignment: center;

                    edited => {
                        root.query = self.text;
                        root.search_changed(self.text);
                        root.selected_index = 0;
                        flick.viewport-y = 0px;
                    }

                    // Every shortcut is resolved by the config-driven keybinding
                    // table on the Rust side; the UI only performs the action.
                    key-pressed(event) => {
                        let action = root.resolve_key(
                            event.text,
                            event.modifiers.control,
                            event.modifiers.alt,
                            event.modifiers.shift,
                            event.modifiers.meta,
                        );
                        if (action == "down") {
                            root.select_next();
                            return accept;
                        }
                        if (action == "up") {
                            root.select_prev();
                            return accept;
                        }
                        if (action == "close") {
                            root.escape_pressed();
                            return accept;
                        }
                        if (action == "execute") {
                            if (root.items.length > 0) {
                                root.item_executed(root.selected_index);
                            }
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            flick := Flickable {
                height: root.list_view_height;
                viewport-height: root.items.length * root.row_total_height;

                for item[index] in root.items : Rectangle {
                    y: index * root.row_total_height;
                    width: flick.width;
                    height: root.item_height;
                    border-radius: 0px;
                    background: root.selected_index == index ? root.theme_selection_bg : transparent;

                    Rectangle {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        background: transparent;

                        Image {
                            source: item.icon;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }

                    // Text row: when a path is shown, name and path split the row
                    // in half so neither can squeeze the other out; otherwise the
                    // name gets the whole row. Either side scrolls on its own.
                    HorizontalLayout {
                        x: 36px;
                        y: 0px;
                        width: parent.width - 42px;
                        height: parent.height;
                        spacing: 12px;

                        // Matched characters are rendered as a chain of
                        // zero-gap spans so the name still reads as one word.
                        // `alignment: start` is required: the default is
                        // `stretch`, which would split the row evenly between
                        // each span and leave large gaps (e.g. "qu" / "te…").
                        name_box := Rectangle {
                            width: item.subtitle != "" ? (parent.width - 12px) / 2 : parent.width;
                            height: parent.height;
                            clip: true;

                            // Seamless dual-ribbon marquee driven by the wall clock, not
                            // by a state transition: `animate` is disabled when a row is
                            // created in its final selected state, but animation-tick()
                            // always runs, so an overlong first hit scrolls from frame one.
                            property <length> marquee_gap: 32px;
                            property <length> loop_dist: name_track.preferred-width + self.marquee_gap;
                            property <bool> is_overflow: name_track.preferred-width > self.width;
                            property <bool> active: root.selected_index == index && self.is_overflow;

                            // Time axis: a linear 0..1 progress looping every cycle.
                            property <float> progress: Math.mod(animation-tick(), root.theme_marquee_duration) / root.theme_marquee_duration;
                            property <length> scroll_offset: -self.progress * self.loop_dist;

                            // Leading copy.
                            name_track := HorizontalLayout {
                                x: name_box.active ? name_box.scroll_offset : 0px;
                                height: parent.height;
                                alignment: start;
                                spacing: 0px;

                                for span in item.spans : Text {
                                    text: span.text;
                                    color: span.is_match
                                        ? (root.selected_index == index ? root.theme_selection_match : root.theme_match)
                                        : (root.selected_index == index ? root.theme_selection_text : root.theme_text);
                                    font-size: 14.5px;
                                    font-weight: span.is_match ? 700 : 400;
                                    vertical-alignment: center;
                                }
                            }

                            // Trailing copy sits exactly loop_dist behind the lead,
                            // completing the loop; only rendered while active.
                            if name_box.active : HorizontalLayout {
                                x: name_track.x + name_box.loop_dist;
                                height: parent.height;
                                alignment: start;
                                spacing: 0px;

                                for span in item.spans : Text {
                                    text: span.text;
                                    color: span.is_match
                                        ? (root.selected_index == index ? root.theme_selection_match : root.theme_match)
                                        : (root.selected_index == index ? root.theme_selection_text : root.theme_text);
                                    font-size: 14.5px;
                                    font-weight: span.is_match ? 700 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if item.subtitle != "" : subtitle_box := Rectangle {
                            width: (parent.width - 12px) / 2;
                            height: parent.height;
                            clip: true;

                            property <length> marquee_gap: 32px;
                            property <length> loop_dist: sub1.preferred-width + self.marquee_gap;
                            property <bool> is_overflow: sub1.preferred-width > self.width;
                            property <bool> active: root.selected_index == index && self.is_overflow;

                            // Progress is shared with the name ribbon (same cycle),
                            // but each box has its own distance, so the two sides
                            // scroll at the pace that suits their text length.
                            property <float> progress: Math.mod(animation-tick(), root.theme_marquee_duration) / root.theme_marquee_duration;
                            property <length> scroll_offset: -self.progress * self.loop_dist;

                            // Leading copy. While idle it is pushed to the right
                            // edge of its half, so the path hugs the window's
                            // right side (and an overflowing path shows its tail,
                            // which is where the file name is). While scrolling
                            // it starts from the left instead, so the ribbon reads
                            // in natural order.
                            sub1 := Text {
                                text: item.subtitle;
                                color: #6272a4;
                                font-size: 12px;
                                height: 100%;
                                vertical-alignment: center;

                                x: subtitle_box.active
                                    ? subtitle_box.scroll_offset
                                    : subtitle_box.width - self.preferred-width;
                            }

                            // Trailing copy sits exactly loop_dist behind the lead, completing
                            // the seamless loop; only rendered while active (matches lead).
                            if subtitle_box.active : Text {
                                text: item.subtitle;
                                color: #6272a4;
                                font-size: 12px;
                                height: 100%;
                                vertical-alignment: center;

                                x: sub1.x + subtitle_box.loop_dist;
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.selected_index = index;
                            root.item_executed(index);
                        }
                    }
                }
            }
        }
    }
}
